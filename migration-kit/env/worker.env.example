# ── Railway WORKER service env ─────────────────────────────────────────────
# The worker POSTs the web service's hook endpoints on a schedule, replacing
# the Lovable/pg_cron net.http_post jobs. It removes the URL coupling entirely.

# Where the web service lives (the worker calls its /api/public/hooks/* + email route)
APP_URL=https://app.marketinglube.ai

# Must match the web service's CRON_SECRET (authenticates the hook calls)
CRON_SECRET=SAME_AS_WEB_SERVICE

# Service role key — used only for the email-queue drain route (Bearer auth on
# /lovable/email/queue/process). Same value as the web service.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXX

# ── Schedules (cron expressions; sensible defaults mirror the Lovable jobs) ──
# Override any of these to match what you captured in db/00_capture_live_state.sql.
CRON_EMAIL_QUEUE=*/10 * * * * *      # every 10s (Lovable used 5s; 10s is plenty)
CRON_PRECOMPUTE=*/2 * * * *          # every 2 min — tile warmer
CRON_INGEST_GHL=*/15 * * * *         # every 15 min
CRON_INGEST_META=*/15 * * * *        # every 15 min
CRON_INGEST_STRIPE=*/30 * * * *      # every 30 min
CRON_RUN_ANALYSIS=0 8 * * *          # daily 08:00 UTC (AI insights)

# Set to "false" to disable a job without redeploying
ENABLE_EMAIL_QUEUE=true
ENABLE_PRECOMPUTE=true
ENABLE_INGEST=true
ENABLE_ANALYSIS=true
