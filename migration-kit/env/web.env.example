# ── Railway WEB service env ────────────────────────────────────────────────
# Values marked (SAME) must be byte-identical to Lovable to avoid re-auth/token breakage.

# Supabase (YOUR new project) — VITE_* are build-time, injected into the browser bundle
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXX
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXX
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXX          # server-only, never VITE_
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres  # for the Tier-2 SQL-aggregation refactor

# App identity — kills the hardcoded data-charm-hub-20.lovable.app fallback
APP_URL=https://app.marketinglube.ai
VITE_APP_URL=https://app.marketinglube.ai

# Meta — (SAME) as Lovable. META_APP_SECRET also signs OAuth state; never leave unset.
META_APP_ID=XXXXXXXXXXXX
META_APP_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Private secret replacing the public-key hook auth (fixes S1). 32+ random bytes.
CRON_SECRET=REPLACE_WITH_openssl_rand_hex_32

# Stable OTP-code pepper replacing the LOVABLE_API_KEY pepper (access.server.ts).
# Keep the OLD LOVABLE_API_KEY value available for a ~3h overlap so in-flight codes verify.
CODE_PEPPER=REPLACE_WITH_openssl_rand_hex_32

# Email (Resend). Verify DKIM/SPF for app.marketinglube.ai + notify.app.marketinglube.ai first.
RESEND_API_KEY=re_XXXX
EMAIL_FROM=Marketing Lube <noreply@app.marketinglube.ai>

# AI insights — direct endpoint replacing ai.gateway.lovable.dev (OpenAI-compatible)
AI_GATEWAY_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_MODEL=gemini-2.5-flash
AI_API_KEY=XXXX

# Build: force Nitro to emit a Node server (see build/vite.config.node.ts)
NITRO_PRESET=node-server

# Only if you keep the LOVABLE_API_KEY-dependent OTP overlap during cutover:
# LOVABLE_API_KEY=old_value_for_3h_overlap_only
